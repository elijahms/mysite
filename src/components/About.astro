---
import { education, offline, path, toolbox } from "@/data/site"
---

<section class="about" id="about" aria-labelledby="about-title">
  <div class="wrap">
    <div class="about__head">
      <h2 class="section-title" id="about-title">Code, then markets</h2>
      <p class="about__intro">
        I came to engineering from business school and consulting, spent two years writing the tools a trading floor runs
        on, then crossed the desk to use them. Knowing both sides is the point: I can talk to the people who need the
        software and then go build it.
      </p>
    </div>

    <ol class="timeline" reversed>
      {
        path.map((role) => (
          <li class="timeline__row">
            <p class="timeline__years">
              <time>{role.start}</time>
              <span aria-hidden="true">to</span>
              <span class="visually-hidden">to</span>
              {role.end === "Now" ? <span>now</span> : <time>{role.end}</time>}
            </p>
            <div class="timeline__what">
              <h3 class="timeline__title">{role.title}</h3>
              <p class="timeline__org">
                {role.org}, {role.place}
              </p>
            </div>
            <p class="timeline__summary">{role.summary}</p>
          </li>
        ))
      }
    </ol>

    <div class="facts">
      <div class="facts__group">
        <h3 class="facts__title">Studied</h3>
        <ul class="facts__list">
          {
            education.map((item) => (
              <li>
                <strong>{item.school}</strong>
                <br />
                {item.detail}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="facts__group">
        <h3 class="facts__title">Tools I reach for</h3>
        <ul class="facts__tags">
          {toolbox.map((tool) => <li>{tool}</li>)}
        </ul>
      </div>
      <div class="facts__group">
        <h3 class="facts__title">Away from a screen</h3>
        <ul class="facts__list">
          {offline.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    padding-block: clamp(4rem, 10vw, 8rem);
    background: var(--paper-raised);
    border-block: 1px solid var(--rule);
  }

  .about__head {
    display: grid;
    gap: 1.5rem;
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }

  @media (min-width: 64rem) {
    .about__head {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: 5rem;
      align-items: end;
    }
  }

  .about__intro {
    max-width: 44ch;
    font-size: var(--step-1);
    line-height: 1.45;
  }

  /* A real sequence, so it gets a real timeline: years down the left edge. */
  .timeline {
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ink);
  }

  .timeline__row {
    display: grid;
    gap: 0.5rem 2rem;
    padding-block: clamp(1.5rem, 3vw, 2.25rem);
    border-bottom: 1px solid var(--rule);
  }

  @media (min-width: 48rem) {
    .timeline__row {
      grid-template-columns: 9rem minmax(0, 1fr);
    }
    .timeline__summary {
      grid-column: 2;
    }
  }

  @media (min-width: 64rem) {
    .timeline__row {
      grid-template-columns: 11rem minmax(0, 5fr) minmax(0, 6fr);
      gap: 3rem;
      align-items: baseline;
    }
    .timeline__summary {
      grid-column: auto;
    }
  }

  .timeline__years {
    display: flex;
    gap: 0.4em;
    font-family: var(--display);
    font-size: var(--step-2);
    font-weight: 700;
    font-stretch: 70%;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .timeline__years span[aria-hidden] {
    color: var(--graphite);
    font-weight: 400;
  }

  .timeline__title {
    font-family: var(--text);
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .timeline__org {
    margin-top: 0.3rem;
    color: var(--graphite);
  }

  .timeline__summary {
    max-width: var(--measure);
    color: var(--graphite);
  }

  .facts {
    display: grid;
    gap: 2.5rem 3rem;
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }

  @media (min-width: 56rem) {
    .facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .facts__title {
    margin-bottom: 1rem;
    font-family: var(--text);
    font-size: var(--step-0);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0;
  }

  .facts__list {
    display: grid;
    gap: 0.9rem;
    padding: 0;
    list-style: none;
    color: var(--graphite);
  }

  .facts__list strong {
    color: var(--ink);
    font-weight: 600;
  }

  .facts__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }

  .facts__tags li {
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--paper);
    font-size: 0.925rem;
  }
</style>
