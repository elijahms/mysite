---
import Base from "@/layouts/Base.astro"
import { site } from "@/data/site"
---

<Base title={`Page not found | ${site.name}`}>
  <main id="main" class="lost wrap">
    <h1 class="lost__code">404</h1>
    <p class="lost__text">This page doesn't exist, or it moved when the site was rebuilt.</p>
    <a class="button button--solid" href="/">Go to the home page</a>
  </main>
</Base>

<style>
  .lost {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 1.5rem;
    min-height: 100svh;
  }

  .lost__code {
    font-size: clamp(7rem, 30vw, 20rem);
    font-weight: 900;
    font-stretch: 50%;
    line-height: 0.8;
  }

  .lost__text {
    max-width: 34ch;
    font-size: var(--step-1);
  }
</style>
